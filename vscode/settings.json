{
  "[dockercompose]": {
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.insertSpaces": true,
    "editor.quickSuggestions": {
      "comments": false,
      "other": true,
      "strings": true,
    },
    "editor.tabSize": 2,
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "[html]": {
    "emmet.showAbbreviationSuggestions": true,
  },
  "[json]": {
    "editor.wordWrap": "on",
  },
  "[markdown]": {
    "editor.wordWrap": "on",
  },
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma",
  },
  "breadcrumbs.enabled": true,
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.acceptSuggestionOnEnter": "smart",
  "editor.bracketPairColorization.enabled": true,
  "editor.cursorBlinking": "expand",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.folding": true,
  "editor.fontFamily": "\"Dank Mono\", \"Berkeley Mono\", \"DankMono Nerd Font\", \"Berkeley Mono\", Menlo, Monaco, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 16,
  "editor.fontWeight": "500",
  "editor.formatOnSave": true,
  "editor.guides.highlightActiveIndentation": true,
  "editor.guides.indentation": false,
  "editor.hover.delay": 300,
  "editor.lightbulb.enabled": "off",
  "editor.lineNumbers": "relative",
  "editor.minimap.enabled": false,
  "editor.minimap.maxColumn": 0,
  "editor.guides.bracketPairs": "active",
  "editor.quickSuggestions": {
    "comments": "off",
    "strings": "off",
  },
  "editor.quickSuggestionsDelay": 200,
  "editor.renderWhitespace": "none",
  "editor.rulers": [100, 120],
  "editor.scrollBeyondLastLine": true,
  "editor.scrollbar.horizontal": "auto",
  "editor.showFoldingControls": "never",
  "editor.smoothScrolling": true,
  "editor.snippetSuggestions": "top",
  "editor.stickyScroll.enabled": true,
  "editor.suggest.insertMode": "replace",
  "editor.suggest.localityBonus": true,
  "editor.suggest.shareSuggestSelections": false,
  "editor.suggest.showKeywords": false,
  "editor.suggestSelection": "first",
  "editor.tabCompletion": "on",
  "editor.tabSize": 2,
  "editor.wordWrap": "off",
  "emmet.showAbbreviationSuggestions": false,
  "emmet.showExpandedAbbreviation": "never",
  "errorLens.enabled": true,
  "errorLens.fontFamily": "Berkeley Mono",
  "errorLens.fontSize": "12px",
  "errorLens.gutterIconsEnabled": true,
  "eslint.format.enable": true,
  // "eslint.useFlatConfig": true,
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableCommitSigning": true,
  "github.copilot.enable": {
    "*": false,
  },
  "githubPullRequests.pullBranch": "never",
  "javascript.suggest.paths": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "prettier.requireConfig": false,
  "scm.diffDecorations": "gutter",
  "search.exclude": {
    "**/.next": true,
    "**/dist": true,
    "**/node_modules": true,
  },
  "task.quickOpen.showAll": false,
  "telemetry.telemetryLevel": "off",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.enablePersistentSessions": true,
  "terminal.integrated.fontFamily": "DankMono Nerd Font",
  "terminal.integrated.fontSize": 15,
  "terminal.integrated.scrollback": 1000000,
  "todo-tree.general.tags": ["TODO", "FIXME", "BUG", "NOTE"],
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "typescript.suggest.completeFunctionCalls": true,
  "typescript.suggest.paths": true,
  "typescript.tsserver.maxTsServerMemory": 16384,
  "typescript.tsserver.useSyntaxServer": "auto",
  "typescript.tsserver.watchOptions": {
    "fallbackPolling": "dynamicPriorityPolling",
    "watchDirectory": "useFsEvents",
    "watchFile": "useFsEvents",
  },
  "typescript.updateImportsOnFileMove.enabled": "always",
  "vim.easymotion": true,
  "vim.foldfix": true,
  "vim.handleKeys": {
    "<C-c>": false,
  },
  "vim.highlightedyank.enable": true,
  "vim.hlsearch": true,
  "vim.leader": ",",
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["<leader>", "f"],
      "commands": ["editor.action.formatDocument"],
    },
    {
      "before": ["<leader>", "s"],
      "commands": ["workbench.action.files.save"],
    },
    {
      "before": ["<leader>", "t"],
      "commands": ["workbench.action.terminal.toggleTerminal"],
    },
    {
      "before": ["<leader>", "e"],
      "commands": ["workbench.view.explorer"],
    },
    {
      "before": ["<leader>", "c"],
      "commands": ["workbench.action.closeActiveEditor"],
    },
    {
      "before": ["<leader>", "C"],
      "commands": ["workbench.action.closeAllEditors"],
    },
    {
      "before": ["<leader>", "p"],
      "commands": ["workbench.action.quickOpen"],
    },
    {
      "before": ["[", "d"],
      "commands": ["editor.action.mark.prev"],
    },
    {
      "before": ["]", "d"],
      "commands": ["editor.action.mark.next"],
    },
    {
      "before": ["<leader>", "c", "a"],
      "commands": ["editor.action.quickFix"],
    },
    {
      "before": ["[", "c"],
      "commands": ["editor.action.marker.prevInFiles"],
    },
    {
      "before": ["]", "c"],
      "commands": ["editor.action.marker.nextInFiles"],
    },
    {
      "before": ["[", "b"],
      "commands": ["workbench.action.editor.previousChange"],
    },
    {
      "before": ["]", "b"],
      "commands": ["workbench.action.editor.nextChange"],
    },
    {
      "before": ["<leader>", "n"],
      "commands": ["workbench.action.nextEditor"],
    },
    {
      "before": ["<leader>", "N"],
      "commands": ["workbench.action.previousEditor"],
    },
  ],
  "vim.showMarksInGutter": true,
  "vim.smartRelativeLine": true,
  "vim.useSystemClipboard": true,
  "window.autoDetectColorScheme": true,
  "window.commandCenter": false,
  "window.titleBarStyle": "native",
  "window.zoomPerWindow": false,
  "workbench.activityBar.location": "top",
  "workbench.colorCustomizations": {
    "editorBracketHighlight.foreground1": "#a99f70",
    "editorBracketHighlight.foreground2": "#66CCBB",
    "editorBracketHighlight.foreground3": "#FF80BF",
    "editorBracketHighlight.foreground4": "#AA99FF",
    "editorBracketHighlight.foreground5": "#70A99F",
    "editorBracketHighlight.foreground6": "#6ECC66",
  },
  "workbench.iconTheme": "vira-icons-palenight",
  "workbench.editor.showTabs": "single",
  "workbench.preferredDarkColorTheme": "Dracula Pro",
  "workbench.preferredLightColorTheme": "Vira Carbon High Contrast",
  "workbench.sideBar.location": "right",
  "workbench.startupEditor": "none",
  "workbench.statusBar.visible": true,
  "workbench.tips.enabled": false,
  "workbench.tree.renderIndentGuides": "onHover",
  "peacock.affectPanelBorder": true,
  "peacock.affectSideBarBorder": true,
  "peacock.affectStatusAndTitleBorders": true,
  "peacock.affectTitleBar": false,
  "peacock.surpriseMeOnStartup": true,
  "powermode.enabled": true,
  "powermode.explosions.enabled": true,
  "powermode.shake.enabled": false,
  "powermode.shake.intensity": 0,
  "powermode.combo.location": "off",
  "powermode.combo.counterEnabled": "hide",
  "powermode.combo.timerEnabled": "hide",
  "powermode.explosions.size": 12,
  "powermode.explosions.frequency": 2,
  "powermode.explosions.duration": 500,
  "workbench.productIconTheme": "viraUIIcons",
  "viraTheme.accent": "Lime",
}
